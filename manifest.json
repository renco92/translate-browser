{
  "manifest_version": 3,
  "name": "Quizzler Web Immersion & Flashcard Studio",
  "version": "1.0.0",
  "description": "Translate any webpage into the language you are learning, inspect words with native audio, IPA, Furigana & Kanji breakdown, and master vocabulary with 3D tactile flashcards.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Quizzler Immersion & Flashcards",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/content.css"],
      "js": [
        "data/french_vocab_db.js",
        "data/japanese_vocab_db.js",
        "shared/sound_engine.js",
        "shared/storage_manager.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "studio/studio.html",
        "icons/icon-16.png",
        "icons/icon-48.png",
        "icons/icon-128.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "translate-page": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "Translate & tokenize current webpage into your target language"
    },
    "tokenize-native-page": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Tokenize native target-language webpage for word-by-word inspection"
    }
  }
}
